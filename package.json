{
  "name": "@artstesh/forger",
  "version": "2.0.1",
  "description": "A legal way to forge everything you want ;)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "homepage": "https://forger.artstesh.ru",
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "test": "tspc -b tsconfig.test.json && jest --config jest.config.js",
    "build": "tspc -b tsconfig.json",
    "pre-jest": "tspc -b tsconfig.test.json",
    "debug-jest": "jest --config jest.config.js -- /spec/partial.spec.ts --clearCache"
  },
  "keywords": [
    "forgery",
    "forger",
    "autofixture",
    "mock",
    "typescript",
    "fixture",
    "randomizer",
    "tdd"
  ],
  "author": "artstesh",
  "license": "MIT",
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artstesh/forger.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "ts-jest": "29.1.2",
    "ts-transformer-keys": "0.4.4",
    "tslint": "6.1.3",
    "tslint-config-prettier": "1.18.0",
    "ts-patch": "3.1.2",
    "typescript": "^5.0.2",
    "@artstesh/it-should": "^1.1.4",
    "tsutils": "2.29.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.2"
  }
}
